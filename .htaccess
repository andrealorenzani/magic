# Used when the web directory is the project root: serve public/ as the site root.
# serve public/ as the site root. Nothing outside public/ (src, templates, cache, docs, tests…) is reachable.
Options -Indexes
RewriteEngine On

# /public/... (old URL) -> /...
RewriteCond %{THE_REQUEST} \s/public(/[^\s?]*)?[\s?]
RewriteRule ^public(/.*)?$ $1 [R=301,L]

# everything else is served from public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
